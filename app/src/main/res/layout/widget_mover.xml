<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mover_widget_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_round_background"
    android:orientation="vertical"
    android:padding="@dimen/tiny_margin">

    <LinearLayout
        android:id="@+id/mover_thumbs_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mover_thumb_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/mover_thumb_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/mover_thumb_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/mover_thumb_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/mover_thumb_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:scaleType="centerCrop" />

    </LinearLayout>

    <TextView
        android:id="@+id/mover_move_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tiny_margin"
        android:background="@drawable/widget_round_background"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/bigger_text_size"
        tools:ignore="HardcodedText"
        tools:text="Move 12 files" />

</LinearLayout>
