<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 Auto Backup: exclude local media cache database and security/password preferences
     from cloud backup so private paths and lock hashes are not uploaded. -->
<full-backup-content>
    <exclude domain="database" path="gallery.db" />
    <exclude domain="database" path="gallery.db-wal" />
    <exclude domain="database" path="gallery.db-shm" />
    <exclude domain="sharedpref" path="Prefs.xml" />
</full-backup-content>
