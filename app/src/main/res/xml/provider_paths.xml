<?xml version="1.0" encoding="utf-8"?>
<paths>
    <external-path name="external_files" path="." />
    <!-- Restrict cache sharing strictly to the temporary editor-share subdirectory, and omit
         files-path so internal app data (crash logs, viewer sessions, scan caches) is never exposed. -->
    <cache-path name="shared_images" path="images/" />
    <!-- Restrict root-path to /storage/ (needed for removable SD cards / OTG) instead of exposing /. -->
    <root-path name="storage_volumes" path="storage/" />
</paths>
