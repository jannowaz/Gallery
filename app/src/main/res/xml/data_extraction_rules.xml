<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): back up settings (shared prefs incl. pinned items),
     the Room databases (collections, favorites, media cache) and files so they
     survive a reinstall / device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
